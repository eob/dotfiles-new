#!/usr/bin/env python3
"""
brain: Unified command-line interface for personal and enterprise AI brains.

Usage: brain <command> [args...]

Core Commands:
  search <query>      Hybrid vector + keyword search over all notes
  embed <file>...     Embed or re-embed specific markdown files
  sweep               Incrementally update index for modified files
  reindex             Rebuild entire vector index from scratch
  inbox [cmd]         Linear intake bridge (next, list, inspect, handle, close)
  today               View/initialize today's cowork log and rolled tasks
  remind <date> <txt> Schedule a date-seeded reminder in cowork logs
  sync [message]      Sweep index, validate, and push to origin/main
  doctor              Run full 4-point health check (links, index, Linear, git)
  validate            Validate links, claim-ledger schema, and budget

Discovers repository via $BRAIN_REPO, current directory, or fallback locations.
"""

import os
import subprocess
import sys
from pathlib import Path

DOTFILES_ROOT = Path(__file__).resolve().parent.parent
TOOLS_DIR = DOTFILES_ROOT / "tools" / "brain"

# Ensure tools/brain is importable
if str(TOOLS_DIR) not in sys.path:
    sys.path.insert(0, str(TOOLS_DIR))

try:
    from brain_repo import get_brain_root
except ImportError:
    print(f"Error: Could not import brain_repo from {TOOLS_DIR}", file=sys.stderr)
    sys.exit(1)

DISPATCH_MAP = {
    "bootstrap": TOOLS_DIR / "bootstrap.py",
    "inbox": TOOLS_DIR / "brain_inbox.py",
    "index": TOOLS_DIR / "brain_index.py",
    "validate": TOOLS_DIR / "validate_brain.py",
    "cowork": TOOLS_DIR / "cowork.py",
}


def cmd_doctor():
    """Run full system diagnostics on brain environment, tools, and remote sync."""
    repo_root = get_brain_root()
    print("=== Brain Diagnostics ===")
    print(f"Active Brain Repo : {repo_root}")

    # 1. Validate markdown and claims
    print("\n[1/4] Validating repository structure and links...")
    subprocess.run([sys.executable, str(TOOLS_DIR / "validate_brain.py")])

    # 2. Vector index status
    db_path = repo_root / "agent" / "cache" / "brain-index.db"
    status_str = f"FOUND ({db_path.stat().st_size // 1024} KB)" if db_path.exists() else "NOT FOUND (run brain sweep)"
    print(f"\n[2/4] Vector index cache: {status_str}")

    # 3. Linear API status
    print("\n[3/4] Linear Intake Bridge...")
    subprocess.run([sys.executable, str(TOOLS_DIR / "brain_inbox.py"), "status"])

    # 4. Git status
    print("\n[4/4] Git Sync Status...")
    git_proc = subprocess.run(["git", "-C", str(repo_root), "status", "-s"], capture_output=True, text=True)
    if git_proc.returncode == 0:
        if not git_proc.stdout.strip():
            print("Git working tree clean.")
        else:
            print("Uncommitted changes detected:")
            for line in git_proc.stdout.strip().splitlines()[:5]:
                print(f"  {line}")
    print("\nDiagnostics complete.")


def cmd_sync(msg: str | None = None):
    """Sweep vector index, validate links, and push changes to origin/main."""
    repo_root = get_brain_root()
    print(f"=== Synchronizing Brain ({repo_root.name}) ===")

    print("\n[1/3] Sweeping vector index...")
    sweep = subprocess.run([sys.executable, str(TOOLS_DIR / "brain_index.py"), "sweep"])
    if sweep.returncode != 0:
        print("Error: Index sweep failed.", file=sys.stderr)
        sys.exit(sweep.returncode)

    print("\n[2/3] Validating markdown and budget...")
    val = subprocess.run([sys.executable, str(TOOLS_DIR / "validate_brain.py")])
    if val.returncode != 0:
        print("Error: Validation failed.", file=sys.stderr)
        sys.exit(val.returncode)

    print("\n[3/3] Checking Git working tree...")
    status = subprocess.run(
        ["git", "-C", str(repo_root), "status", "--porcelain"],
        capture_output=True,
        text=True,
    )
    if status.stdout.strip():
        commit_msg = msg or "chore(brain): synchronize knowledge base and index"
        print(f"Staging and committing changes: '{commit_msg}'...")
        subprocess.run(["git", "-C", str(repo_root), "add", "."], check=True)
        subprocess.run(["git", "-C", str(repo_root), "commit", "-m", commit_msg], check=True)

    print("Pushing to origin/main...")
    push = subprocess.run(["git", "-C", str(repo_root), "push", "origin", "main"])
    if push.returncode == 0:
        print("\nBrain successfully synchronized and pushed to origin/main.")
    else:
        print("\nPush failed.", file=sys.stderr)
        sys.exit(push.returncode)


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ["-h", "--help"]:
        print("Usage: brain <command> [args...]")
        print("\nCore Commands:")
        print("  bootstrap [dir]     Bootstrap a new cognitive brain repository")
        print("  search <query>      Hybrid vector + keyword search over all notes")
        print("  embed <file>...     Embed or re-embed specific markdown files")
        print("  sweep               Incrementally update index for modified files")
        print("  reindex             Rebuild entire vector index from scratch")
        print("  inbox [cmd]         Linear intake bridge (next, list, inspect, handle, close)")
        print("  today               View/initialize today's cowork log and rolled tasks")
        print("  remind <date> <txt> Schedule a date-seeded reminder in cowork logs")
        print("  sync [message]      Sweep index, validate, and push to origin/main")
        print("  doctor              Run full 4-point health check (links, index, Linear, git)")
        print("  validate            Validate links, claim-ledger schema, and budget")
        sys.exit(0)

    cmd = sys.argv[1]
    subargs = sys.argv[2:]

    # Direct aliases
    if cmd == "bootstrap":
        result = subprocess.run([sys.executable, str(TOOLS_DIR / "bootstrap.py")] + subargs)
        sys.exit(result.returncode)
    if cmd == "search":
        result = subprocess.run([sys.executable, str(TOOLS_DIR / "brain_index.py"), "search"] + subargs)
        sys.exit(result.returncode)

    if cmd == "embed":
        result = subprocess.run([sys.executable, str(TOOLS_DIR / "brain_index.py"), "embed"] + subargs)
        sys.exit(result.returncode)

    if cmd == "sweep":
        result = subprocess.run([sys.executable, str(TOOLS_DIR / "brain_index.py"), "sweep"] + subargs)
        sys.exit(result.returncode)

    if cmd == "reindex":
        result = subprocess.run([sys.executable, str(TOOLS_DIR / "brain_index.py"), "reindex"] + subargs)
        sys.exit(result.returncode)

    if cmd == "today":
        result = subprocess.run([sys.executable, str(TOOLS_DIR / "cowork.py"), "today"] + subargs)
        sys.exit(result.returncode)

    if cmd == "remind":
        result = subprocess.run([sys.executable, str(TOOLS_DIR / "cowork.py"), "remind"] + subargs)
        sys.exit(result.returncode)

    if cmd == "doctor":
        cmd_doctor()
        sys.exit(0)

    if cmd == "sync":
        msg = subargs[0] if subargs else None
        cmd_sync(msg)
        sys.exit(0)

    # Dispatch to specific module
    if cmd not in DISPATCH_MAP:
        print(f"Unknown command: '{cmd}'", file=sys.stderr)
        print("Run 'brain --help' to see available commands.", file=sys.stderr)
        sys.exit(1)

    target_script = DISPATCH_MAP[cmd]
    if not target_script.exists():
        print(f"Tool script not found: {target_script}", file=sys.stderr)
        sys.exit(1)

    result = subprocess.run([sys.executable, str(target_script)] + subargs)
    sys.exit(result.returncode)


if __name__ == "__main__":
    main()
